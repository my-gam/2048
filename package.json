{
  "name": "@my-games/2048-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "2048 游戏：跨框架 core + Vue 3 适配器 + React 18 适配器",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm build && pnpm --filter playground dev",
    "dev:play": "pnpm --filter playground dev",
    "test": "pnpm -r --filter './packages/**' test",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
