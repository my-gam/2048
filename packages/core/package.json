{
  "name": "@my-games/2048-core",
  "version": "0.1.0",
  "description": "2048 游戏核心引擎：无框架依赖、可测试、含 expectimax AI。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": ["./src/styles.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  },
  "keywords": ["2048", "game", "core", "puzzle", "ai", "expectimax", "typescript"],
  "license": "MIT",
  "author": { "name": "xyj2156" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-gam/2048.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/my-gam/2048/tree/main/packages/core#readme",
  "bugs": { "url": "https://github.com/my-gam/2048/issues" },
  "publishConfig": { "access": "public" }
}
