{
  "name": "@my-games/2048-core",
  "version": "0.3.1",
  "description": "Framework-agnostic 2048 game engine with expectimax AI; ships ESM, CJS, UMD and IIFE builds. 无框架依赖的 2048 引擎，四格式产出。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.iife.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": "./dist/index.umd.js",
    "./iife": "./dist/index.iife.js",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": ["./src/styles.css"],
  "scripts": {
    "build": "vite build --mode lib",
    "dev": "vite build --mode lib --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "2048",
    "game",
    "game-engine",
    "puzzle",
    "core",
    "ai",
    "expectimax",
    "typescript",
    "esm",
    "cjs",
    "umd",
    "iife",
    "browser",
    "h5",
    "mobile-web",
    "zero-dependencies",
    "cross-framework"
  ],
  "license": "MIT",
  "author": { "name": "xyj2156" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-gam/2048.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/my-gam/2048/tree/main/packages/core#readme",
  "bugs": { "url": "https://github.com/my-gam/2048/issues" },
  "publishConfig": { "access": "public" }
}
