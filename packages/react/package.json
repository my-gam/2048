{
  "name": "@my-games/game-2048-react",
  "version": "0.1.0",
  "description": "2048 游戏的 React 18 组件适配器（函数组件 + Hooks）。",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "@my-games/game-2048-core/styles.css"
