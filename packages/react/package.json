{
  "name": "@my-games/2048-react",
  "version": "0.1.0",
  "description": "2048 游戏的 React 18 组件适配器（函数组件 + Hooks）。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "@my-games/2048-core/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@my-games/2048-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "keywords": ["2048", "react", "react18", "game", "puzzle", "component", "hooks"],
  "license": "MIT",
  "author": { "name": "xyj2156" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-gam/2048.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/my-gam/2048/tree/main/packages/react#readme",
  "bugs": { "url": "https://github.com/my-gam/2048/issues" },
  "publishConfig": { "access": "public" }
}
