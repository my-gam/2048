    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "keywords": ["2048", "react", "game", "puzzle"],
  "license": "MIT"
}
